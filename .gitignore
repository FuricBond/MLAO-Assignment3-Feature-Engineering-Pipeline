# ============================================================
# .gitignore — Feature Engineering Pipeline
# ============================================================

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
.eggs/
dist/
build/
*.egg-info/
*.egg

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/
*.ipynb

# Environment files
.env
.env.local

# IDE settings
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Generated model files (keep .gitkeep, ignore .pkl)
models/*.pkl

# Large dataset files
data/*.csv
data/*.xlsx
data/*.json

# Output files (optional — comment out to track them)
# output/*.csv
# output/*.png

# Logs
*.log
logs/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json
